// Sprint 0 scaffolding: models are added module-by-module as each vertical
// slice is built — see docs/architecture.md section 8. Auth (Organization,
// User), Inventory (Product, StockMovement), Suppliers (Supplier,
// SupplierProduct), Notifications (Notification, ActivityLog), and
// Procurement (PurchaseOrder, PurchaseOrderItem) exist so far; Document
// follows once its module is built.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  admin
  manager
}

enum PurchaseOrderStatus {
  draft
  approved
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  products       Product[]
  suppliers      Supplier[]
  notifications  Notification[]
  activityLogs   ActivityLog[]
  purchaseOrders PurchaseOrder[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  email          String
  passwordHash   String   @map("password_hash")
  role           Role     @default(manager)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  // Email is unique per tenant, not globally — two different organizations
  // may each have a user at the same email address.
  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model Product {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  name            String
  sku             String
  quantity        Int      @default(0)
  safetyThreshold Int      @default(0) @map("safety_threshold")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization       Organization        @relation(fields: [organizationId], references: [id])
  stockMovements     StockMovement[]
  supplierProducts   SupplierProduct[]
  purchaseOrderItems PurchaseOrderItem[]

  // SKU is unique per tenant, not globally.
  @@unique([organizationId, sku])
  @@index([organizationId])
  @@map("products")
}

model StockMovement {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  productId      String   @map("product_id")
  // Signed change applied to Product.quantity (positive = stock in,
  // negative = stock out); the audit trail is this row, quantity itself
  // lives only on Product.
  delta          Int
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([organizationId])
  @@index([productId, createdAt])
  @@map("stock_movements")
}

model Supplier {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  contactEmail   String?  @map("contact_email")
  contactPhone   String?  @map("contact_phone")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id])
  supplierProducts SupplierProduct[]
  purchaseOrders   PurchaseOrder[]

  @@index([organizationId])
  @@map("suppliers")
}

// Structured contract terms per supplier x product — what the deterministic
// supplier-ranking rule reads (docs/architecture.md §8/§9b). One row per
// (supplier, product) pair.
model SupplierProduct {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  supplierId       String   @map("supplier_id")
  productId        String   @map("product_id")
  price            Float
  leadTimeDays     Int      @map("lead_time_days")
  minOrderQty      Int      @map("min_order_qty")
  // 0-100 — higher is better.
  reliabilityScore Float    @map("reliability_score")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  supplier Supplier @relation(fields: [supplierId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([supplierId, productId])
  @@index([organizationId])
  @@index([productId])
  @@map("supplier_products")
}

// Persisted, per-user-facing record of a domain event (e.g. low stock) —
// what drives the toast/badge in the dashboard. See docs/architecture.md §5.
model Notification {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  type           String
  message        String
  read           Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@map("notifications")
}

// Historical record of everything that happened in an organization — powers
// the activity feed. Always written alongside a Notification for the same
// event, but kept as its own append-only table (no `read` state).
model ActivityLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  type           String
  message        String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@map("activity_logs")
}

// Draft/approved order — the terminal artifact of the core workflow in
// README.md. Human-in-the-loop: created as a draft, only becomes official
// once a manager approves it.
model PurchaseOrder {
  id               String              @id @default(uuid())
  organizationId   String              @map("organization_id")
  supplierId       String              @map("supplier_id")
  status           PurchaseOrderStatus @default(draft)
  notes            String?
  approvedByUserId String?             @map("approved_by_user_id")
  approvedAt       DateTime?           @map("approved_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id])
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  items        PurchaseOrderItem[]

  @@index([organizationId, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  purchaseOrderId String   @map("purchase_order_id")
  productId       String   @map("product_id")
  quantity        Int
  unitPrice       Float    @map("unit_price")
  createdAt       DateTime @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])

  @@index([organizationId])
  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}
