// Sprint 0 scaffolding: only Organization + User are modeled so the Auth
// module (the first vertical slice to be built) has a real schema to work
// against. Product, Supplier, Document, PurchaseOrder, etc. are added
// module-by-module — see docs/architecture.md section 8.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  admin
  manager
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  email          String
  passwordHash   String   @map("password_hash")
  role           Role     @default(manager)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  // Email is unique per tenant, not globally — two different organizations
  // may each have a user at the same email address.
  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}
